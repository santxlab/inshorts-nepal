# Copy this to .env.local and fill in the values

# MongoDB (optional for prototype — uses in-memory store without this)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nepal-inshort

# Magic link auth — https://resend.com (free: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address — domain verified in Resend
RESEND_FROM_EMAIL=Inshorts Nepal <noreply@inshortsnepal.org>
# Public URL of this app (used to build magic link URLs)
APP_URL=https://inshortsnepal.org

# ── Firebase (Google Sign-In + Phone OTP) ────────────────────
# Project: Inshorts Nepal (inshorts-nepal-eb5e8)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBV6_mM6atq0G3HnIF-E8RxWfwafmcu6o8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inshorts-nepal-eb5e8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inshorts-nepal-eb5e8
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inshorts-nepal-eb5e8.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=876149197431
NEXT_PUBLIC_FIREBASE_APP_ID=1:876149197431:web:593c618c09e73080255472
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-6PL2Y5WQS4

# Admin credentials (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nepal@admin2024
ADMIN_JWT_SECRET=change-this-to-a-random-secret-string

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-too

# ── Doctor AI ────────────────────────────────────────────────
# Which AI backend powers the symptom assistant.
#   stub   = keyless rule-based intake (default; works with no key)
#   claude = Anthropic API (requires ANTHROPIC_API_KEY below)
DOCTOR_AI_PROVIDER=stub
ANTHROPIC_API_KEY=
DOCTOR_AI_MODEL=claude-haiku-4-5-20251001

# Pract X (doctor lookup / booking) — leave blank to use the built-in mock.
PRACTX_BASE_URL=
PRACTX_API_KEY=
